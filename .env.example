# ---------------------------------------------------------------
# Free AI for the chat tile (the orb card).
# The key is read only in app/api/chat/route.ts — server side — and
# never reaches the browser. With no key set, the card falls back to
# built-in keyword answers, so it always works.
#
# Copy this file to .env.local and fill ONE key in, then restart dev.
# Verify with:  curl http://localhost:3000/api/chat
# ---------------------------------------------------------------

# Google AI Studio — free tier. Get a key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: pin a different model (default: gemini-2.0-flash)
# GOOGLE_MODEL=gemini-2.5-flash

# Alternative provider — console.groq.com, free tier, no card
# GROQ_API_KEY=

# Optional: force one provider when both keys exist (google | groq)
# CHAT_PROVIDER=google
